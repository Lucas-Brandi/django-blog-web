# Copie para .env:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# Porta do front no host (dev) e do nginx (prod)
FRONTEND_PORT=5173
PROD_PORT=8080

# URL do backend, acessada pelo NAVEGADOR.
# O backend (django-blog) expõe a API REST em JSON sob /api/v1/ (DRF + JWT) e
# libera a origem do front por CORS. O cliente HTTP monta a baseURL como
# ${VITE_API_URL}/api/v1 automaticamente.
# Em produção (Vercel), defina esta variável no painel do projeto como a URL do
# backend, SEM barra no final e SEM /api/v1:  https://django-blog-mu.vercel.app
VITE_API_URL=http://localhost:8000

# true: necessário no Windows/macOS com Docker (bind mount). Em Linux nativo pode ser false.
VITE_USE_POLLING=true
