# Copie para .env:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# Porta do front no host (dev) e do nginx (prod)
FRONTEND_PORT=5173
PROD_PORT=8080

# URL do backend, acessada pelo NAVEGADOR.
# Atenção: o backend atual (django-blog) renderiza HTML e ainda não expõe API JSON.
VITE_API_URL=http://localhost:8000

# true: necessário no Windows/macOS com Docker (bind mount). Em Linux nativo pode ser false.
VITE_USE_POLLING=true
